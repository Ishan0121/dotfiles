# Noctalia Secrets Template
# Copy to ~/.config/noctalia/secrets.env (gitignored) or inject into
# ~/.config/noctalia/config.toml locally after stowing.
# NEVER commit real secrets to the dotfiles repository.

# Hotspot plugin password ([plugin_settings."cleboost/hotspot"].password)
# Placeholder in config.toml: REPLACE_WITH_HOTSPOT_PASSWORD
NOCTALIA_HOTSPOT_PASSWORD="REPLACE_WITH_HOTSPOT_PASSWORD"

# Wallhaven API key used by:
#   - [plugin_settings."ishan0121/wallpaper-deck"].wallhaven_api_key
#   - [plugin_settings."noctalia/wallhaven"].api_key
# Placeholder in config.toml: REPLACE_WITH_WALLHAVEN_API_KEY
NOCTALIA_WALLHAVEN_API_KEY="REPLACE_WITH_WALLHAVEN_API_KEY"
