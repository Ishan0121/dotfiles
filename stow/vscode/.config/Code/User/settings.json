  "indentRainbow.updateDelay": 60,
  "powermode.enabled": true,
  "tabnine.experimentalAutoImports": true,
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
  },
  "javascript.updateImportsOnFileMove.enabled": "prompt",
  "animations.Enabled": true,
  "animations.CursorAnimation": true,
  "animations.Durations": {
    "Command-Palette": 300,
    "Tabs": 200,
    "Active": 200,
    "Scrolling": 200,
    "Smooth-Mode": 200,
    "Focus-Dimming": 200,
  },
  "animations.Auto-Install": false,
  "animations.Focus-Dimming-Mode": "Everything But Editor and Terminal",
  "animations.UseCursorColorForCursorAnimation": true,
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.qrc": "default",
    "*.png": "editor.excalidraw",
    "*.qrc": "qt-core.qrcEditor",
  },
  "excalidraw.theme": "auto",
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1,
  },
  "workbench.editor.defaultBinaryEditor": "default",
  "dart.previewFlutterUiGuides": true,
  "dart.previewFlutterUiGuidesCustomTracking": true,
  "go.toolsManagement.autoUpdate": true,
  "code-runner.saveFileBeforeRun": true,
  "workbench.editor.scrollToSwitchTabs": true,
  "workbench.editor.enablePreviewFromCodeNavigation": true,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.guides.bracketPairs": "active",
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
  },
  "redhat.telemetry.enabled": true,
  "remote.portsAttributes": {
    "5500": {
      "protocol": "https",
    },
  },
  "python.analysis.typeCheckingMode": "basic",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "idf.hasWalkthroughBeenShown": true,
  "diffEditor.ignoreTrimWhitespace": true,
  "mssql.connectionGroups": [
    {
      "name": "ROOT",
      "id": "ECAD6A86-A0A5-43B0-A601-C1C0E144C45B",
    },
  ],
  "security.workspace.trust.untrustedFiles": "open",
  "terminal.integrated.defaultProfile.linux": "zsh",
  "geminicodeassist.project": "skillful-enigma-h3lhb",
  "diffEditor.codeLens": true,
  "window.newWindowProfile": "Default",
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
    "*.cs": "${capture}.designer.cs,${capture}.g.cs,${capture}.generated.cs,${capture}.run.json,${capture}.settings.json,${capture}.settings.*.json",
    "*.csproj": "${capture}.csproj.user",
    "*.json": "${capture}.Development.json",
    "*.cshtml": "${capture}.cshtml.cs,${capture}.cshtml.css",
    "*.razor": "${capture}.razor.cs,${capture}.razor.css",
    "*.resx": "${capture}.Designer.cs",
    "*.xaml": "${capture}.xaml.cs",
    "pubspec.yaml": "pubspec.lock,pubspec_overrides.yaml,.packages,.flutter-plugins,.flutter-plugins-dependencies,.metadata",
    "*.dart": "${capture}.g.dart",
    "Cargo.toml": "Cargo.lock",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*",
  },
  "workbench.sideBar.location": "right", // 10 makes it super fast but may cost more resources
  "code-runner.executorMap": {
    "java": "cd $dir && mkdir -p ./class && javac -d ./class $fileName && java -cp ./class $fileNameWithoutExt",
  },
  "hediet.vscode-drawio.theme": "kennedy",
  "hediet.vscode-drawio.appearance": "automatic",
  "window.commandCenter": false,
  "chat.commandCenter.enabled": false,
  "vscode-pets.throwBallWithMouse": true,
  "vscode-pets.petSize": "small",
  "vscode-pets.theme": "beach",
  "chat.sendElementsToChat.attachCSS": false,
  "chat.sendElementsToChat.enabled": false,
  "material-icon-theme.opacity": 1,
  "material-icon-theme.hidesExplorerArrows": false,
  "material-icon-theme.folders.theme": "specific",
  "workbench.productIconTheme": "a-file-icon-vscode-product-icon-theme",
  "workbench.iconTheme": "vscode-icons",
  "chat.viewSessions.orientation": "stacked",
